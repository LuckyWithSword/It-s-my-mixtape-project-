{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in the application",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID"
        },
        "displayName": {
          "type": "string",
          "description": "User display name from Google"
        },
        "email": {
          "type": "string",
          "description": "User email address from Google"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile picture from Google"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["uid"]
    },
    "Mixtape": {
      "title": "Mixtape",
      "description": "User's digital cassette mixtape",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator"
        },
        "title": {
          "type": "string",
          "maxLength": 100,
          "description": "Title of the cassette mixtape"
        },
        "message": {
          "type": "string",
          "maxLength": 500,
          "description": "Personal liner note message on the J-Card"
        },
        "shareId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64,
          "description": "Unique public identifier for public /m/:shareId playback"
        },
        "customization": {
          "type": "object",
          "description": "Cassette aesthetic properties (color, pattern, labelStyle, stickers, screwsColor)"
        },
        "songs": {
          "type": "array",
          "description": "Embedded list of songs for immediate playback",
          "items": {
            "type": "object"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["ownerId", "title", "shareId", "customization"]
    },
    "Track": {
      "title": "Track",
      "description": "Track belonging to a mixtape",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Owner UID of creator"
        },
        "mixtapeId": {
          "type": "string",
          "description": "Parent mixtape ID"
        },
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Song title"
        },
        "youtubeUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "YouTube URL for playback"
        },
        "position": {
          "type": "integer",
          "description": "Track sequence number (1-5)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["mixtapeId", "title", "youtubeUrl", "position"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Private user profile documents"
    },
    "/mixtapes/{mixtapeId}": {
      "schema": {
        "$ref": "#/entities/Mixtape"
      },
      "description": "Mixtapes collection created by authenticated users"
    },
    "/tracks/{trackId}": {
      "schema": {
        "$ref": "#/entities/Track"
      },
      "description": "Tracks collection associated with mixtapes"
    }
  }
}
