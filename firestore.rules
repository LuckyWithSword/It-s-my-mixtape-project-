rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // User profiles collection: Users can only read and write their own profile
    match /users/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;
      allow create: if isValidId(uid) && isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isValidId(uid) && isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if isValidId(uid) && isOwner(uid);
    }

    // Mixtapes collection: Public get and list for playback and sharing, strict owner-only write
    match /mixtapes/{mixtapeId} {
      allow get: if isValidId(mixtapeId);
      allow list: if true;
      allow create: if isSignedIn() && 
                    isValidId(mixtapeId) && 
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.shareId is string &&
                    request.resource.data.title is string;
      allow update: if isSignedIn() && 
                    isValidId(mixtapeId) && 
                    resource.data.ownerId == request.auth.uid &&
                    request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && 
                    isValidId(mixtapeId) && 
                    resource.data.ownerId == request.auth.uid;
    }

    // Tracks collection: Public read for cassette playback, owner-only mutation
    match /tracks/{trackId} {
      allow get: if isValidId(trackId);
      allow list: if true;
      allow create: if isSignedIn() && 
                    isValidId(trackId) && 
                    request.resource.data.mixtapeId is string &&
                    (
                      (request.resource.data.ownerId is string && request.resource.data.ownerId == request.auth.uid) ||
                      (exists(/databases/$(database)/documents/mixtapes/$(request.resource.data.mixtapeId)) &&
                       get(/databases/$(database)/documents/mixtapes/$(request.resource.data.mixtapeId)).data.ownerId == request.auth.uid)
                    );
      allow update: if isSignedIn() && 
                    isValidId(trackId) && 
                    (
                      (resource.data.ownerId == request.auth.uid) ||
                      (exists(/databases/$(database)/documents/mixtapes/$(resource.data.mixtapeId)) &&
                       get(/databases/$(database)/documents/mixtapes/$(resource.data.mixtapeId)).data.ownerId == request.auth.uid)
                    );
      allow delete: if isSignedIn() && 
                    isValidId(trackId) && 
                    (
                      (resource.data.ownerId == request.auth.uid) ||
                      (exists(/databases/$(database)/documents/mixtapes/$(resource.data.mixtapeId)) &&
                       get(/databases/$(database)/documents/mixtapes/$(resource.data.mixtapeId)).data.ownerId == request.auth.uid)
                    );
    }
  }
}
